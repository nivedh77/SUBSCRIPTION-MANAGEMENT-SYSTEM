<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category -->
    <record id="module_category_subscription" model="ir.module.category">
        <field name="name">Subscriptions</field>
        <field name="description">Manage subscription plans, contracts, billing, and customer portal.</field>
        <field name="sequence">25</field>
    </record>

    <!-- User / Staff Group -->
    <record id="group_subscription_user" model="res.groups">
        <field name="name">User (Staff)</field>
        <field name="category_id" ref="module_category_subscription"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Staff members who create and manage subscription orders and customer contracts.</field>
    </record>

    <!-- Administrator Group -->
    <record id="group_subscription_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_subscription"/>
        <field name="implied_ids" eval="[(4, ref('group_subscription_user'))]"/>
        <field name="comment">Full administrative access to subscription plans, contracts, billing settings, and revenue analytics.</field>
    </record>

    <!-- Multi-Company Rules -->
    <record id="subscription_subscription_comp_rule" model="ir.rule">
        <field name="name">Subscription Multi-Company</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="subscription_plan_comp_rule" model="ir.rule">
        <field name="name">Subscription Plan Multi-Company</field>
        <field name="model_id" ref="model_subscription_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Portal User Rule -->
    <record id="subscription_subscription_portal_rule" model="ir.rule">
        <field name="name">Portal Subscriptions</field>
        <field name="model_id" ref="model_subscription_subscription"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
