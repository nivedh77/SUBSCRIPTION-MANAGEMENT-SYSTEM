<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level Root Menu -->
    <menuitem id="menu_subscription_root"
              name="Subscriptions"
              web_icon="subscription_management,static/description/icon.png"
              groups="group_subscription_user"
              sequence="20"/>

    <!-- Operations Section -->
    <menuitem id="menu_subscription_operations"
              name="Subscriptions"
              parent="menu_subscription_root"
              sequence="10"/>

    <!-- Operations -> Subscriptions (All / Active) -->
    <menuitem id="menu_subscription_orders"
              name="Subscriptions"
              parent="menu_subscription_operations"
              action="action_subscription_orders"
              sequence="10"/>

    <!-- Operations -> Quotations -->
    <menuitem id="menu_subscription_quotations"
              name="Quotations"
              parent="menu_subscription_operations"
              action="action_subscription_quotations"
              sequence="20"/>

    <!-- Reporting Section -->
    <menuitem id="menu_subscription_reporting_root"
              name="Reporting"
              parent="menu_subscription_root"
              groups="group_subscription_manager"
              sequence="50"/>

    <!-- Reporting -> Revenue Analytics -->
    <menuitem id="menu_subscription_reporting"
              name="Revenue Analytics"
              parent="menu_subscription_reporting_root"
              action="action_subscription_reporting"
              sequence="10"/>

    <!-- Configuration Section -->
    <menuitem id="menu_subscription_config"
              name="Configuration"
              parent="menu_subscription_root"
              groups="group_subscription_manager"
              sequence="100"/>

    <!-- Configuration -> Subscription Plans -->
    <menuitem id="menu_subscription_plan"
              name="Subscription Plans"
              parent="menu_subscription_config"
              action="action_subscription_plan"
              sequence="10"/>

    <!-- Configuration -> Close Reasons -->
    <menuitem id="menu_subscription_close_reason"
              name="Close Reasons"
              parent="menu_subscription_config"
              action="action_subscription_close_reason"
              sequence="20"/>
</odoo>
